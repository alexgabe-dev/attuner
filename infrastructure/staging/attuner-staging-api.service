[Unit]
Description=Attuner non-production staging API
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=attuner-api
Group=attuner-api
WorkingDirectory=/opt/attuner/current
EnvironmentFile=/etc/attuner-staging/service.env
LoadCredentialEncrypted=api-tls-key:/srv/attuner-staging/secrets/api-tls-key.cred
LoadCredentialEncrypted=api-tls-passphrase:/srv/attuner-staging/secrets/api-tls-passphrase.cred
LoadCredentialEncrypted=token-delivery-key:/srv/attuner-staging/secrets/token-delivery-key.cred
ExecStart=/opt/attuner/current/infrastructure/staging/run-api.sh
Restart=on-failure
RestartSec=15
TimeoutStopSec=130
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/srv/attuner-staging/data
MemoryMax=2G
TasksMax=128
LimitNOFILE=4096
LimitCORE=0
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500

[Install]
WantedBy=multi-user.target
