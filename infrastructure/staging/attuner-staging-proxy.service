[Unit]
Description=Attuner non-production HTTPS gateway
After=network.target attuner-staging-api.service attuner-staging-web.service

[Service]
Type=simple
User=attuner-proxy
Group=attuner-proxy
LoadCredentialEncrypted=edge-tls-key:/srv/attuner-staging/secrets/edge-tls-key.cred
LoadCredentialEncrypted=edge-tls-passphrase:/srv/attuner-staging/secrets/edge-tls-passphrase.cred
ExecStart=/opt/attuner/toolchains/nginx-1.30.6/sbin/nginx -p /var/cache/attuner-staging-proxy/ -c /etc/attuner-staging/nginx.conf -g "daemon off;"
Restart=on-failure
RestartSec=15
KillSignal=SIGQUIT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RuntimeDirectory=attuner-staging-proxy
RuntimeDirectoryMode=0700
CacheDirectory=attuner-staging-proxy
CacheDirectoryMode=0700
MemoryMax=256M
TasksMax=32
LimitNOFILE=4096
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
