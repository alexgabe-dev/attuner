[Unit]
Description=Attuner non-production staging dashboard
After=network.target

[Service]
Type=simple
User=attuner-web
Group=attuner-web
WorkingDirectory=/opt/attuner/current
EnvironmentFile=/etc/attuner-staging/service.env
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/attuner/current/infrastructure/staging/run-web.sh
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/opt/attuner/current/apps/web/.next/cache
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
