{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Attuner",
  "version": "0.1.0",
  "identifier": "app.attuner.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Attuner \u2014 World of Warcraft Configuration Sync",
        "width": 1180,
        "height": 830,
        "minWidth": 800,
        "minHeight": 620,
        "backgroundColor": "#0D0F12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "shortDescription": "Your WoW setup. Everywhere.",
    "category": "Utility",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
